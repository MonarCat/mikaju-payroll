# Copy to .env in the repo root (NOT committed — see .gitignore) and fill
# in real values from Supabase Dashboard → Settings → API.
# Read by apps/desktop/main.js (dotenv) AND by apps/desktop/vite.config.js
# (envDir points here, envPrefix exposes MIKAJU_* to the renderer too).

