{
  "name": "@mikaju/desktop",
  "version": "1.0.3",
  "private": true,
  "description": "Mikaju Payroll desktop app — Electron + React, offline-first.",
  "homepage": "https://github.com/MonarCat/mikaju-payroll",
  "author": {
    "name": "Mikaju Software Solutions",
    "email": "support@mikajusoftware.com"
  },
  "desktopName": "mikaju-payroll.desktop",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder",
    "build:legacy-win7": "vite build && electron-builder --win --x64 --config electron-builder.legacy-win7.json"
  },
  "dependencies": {
    "@mikaju/tax-engine": "^1.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.6"
  },
  "build": {
    "appId": "com.mikajusoftware.payroll",
    "productName": "Mikaju Payroll",
    "executableName": "MikajuPayroll",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "supabaseClient.js",
      "db/**/*",
      "sync/**/*",
      "license/**/*",
      "pdf/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "MonarCat",
      "repo": "mikaju-payroll",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Mikaju-Payroll-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "artifactName": "Mikaju-Payroll.${ext}",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "artifactName": "Mikaju-Payroll.${ext}",
      "synopsis": "Offline-first payroll & HR software for East/Central Africa",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "maintainer": "Mikaju Software Solutions <support@mikajusoftware.com>"
    }
  },
  "license": "UNLICENSED"
}
