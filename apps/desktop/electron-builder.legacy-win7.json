{
  "appId": "com.mikajusoftware.payroll",
  "productName": "Mikaju Payroll",
  "executableName": "MikajuPayroll",
  "directories": {
    "output": "release-legacy"
  },
  "files": [
    "main.js",
    "preload.js",
    "supabaseClient.js",
    "db/**/*",
    "sync/**/*",
    "license/**/*",
    "pdf/**/*",
    "dist/**/*",
    "node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "main.js"
  },
  "publish": {
    "provider": "github",
    "owner": "MonarCat",
    "repo": "mikaju-payroll",
    "releaseType": "release"
  },
  "electronVersion": "22.3.27",
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64", "ia32"] }
    ],
    "artifactName": "Mikaju-Payroll-Setup-Win7-Win8-${arch}.${ext}",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
